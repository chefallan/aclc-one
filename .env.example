# ─── Database ────────────────────────────────────────────────────────────────
# DATABASE_URL is what the running app queries through.
# DIRECT_URL is used only by Prisma Migrate, which needs a real session and
# cannot run through a pooler.
#
# Local Postgres: set both to the same value.
#
# Supabase on Vercel (serverless) — Connect > Transaction pooler:
#   DATABASE_URL  = ...pooler.supabase.com:6543/postgres
#   DIRECT_URL    = ...supabase.com:5432/postgres        (direct, for migrations)
#   DATABASE_POOL_MAX unset — the app uses 1 automatically on Vercel, because
#   every function instance opens its own pool and the project has a cap.
#
# Supabase behind a long-lived container — Session pooler instead:
#   DATABASE_URL  = ...pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/immerse?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/immerse?schema=public"
# DATABASE_POOL_MAX="10"

# Host port docker compose publishes Postgres on, for local development.
# 5432 is often already taken by another project.
DB_PORT="5432"

# ─── Auth ────────────────────────────────────────────────────────────────────
AUTH_SECRET="your-auth-secret-min-32-chars-long-here"
NEXTAUTH_URL="http://localhost:3100"

# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3100"
NODE_ENV="development"

# ─── Storage ─────────────────────────────────────────────────────────────────
# "cloudinary" or "local". Local disk is refused in production: it is not
# durable across container restarts.
# "local" is for development only. Vercel has no writable disk, and the code
# refuses local storage in production for that reason.
STORAGE_PROVIDER="local"
LOCAL_STORAGE_PATH=""

# Assets upload as type "authenticated", so they have no public URL. Photos are
# delivered only through GET /api/photos/[id] after a session check.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="aclc-one/evidence"

# ─── AI provider ─────────────────────────────────────────────────────────────
# "ollama" or "openai". Ollama speaks the OpenAI wire format, so both go
# through the same client and differ only in where they point.
AI_PROVIDER="ollama"

# — Ollama Cloud (default) —
# Leave OLLAMA_BASE_URL unset for the hosted service. Create a key at
# https://ollama.com/settings/keys
OLLAMA_API_KEY=""
# OLLAMA_BASE_URL="https://ollama.com/v1"
#
# — Ollama running locally —
# No key needed; the placeholder is only there because the SDK demands one.
# OLLAMA_BASE_URL="http://localhost:11434/v1"
#
# Use the name exactly as the OpenAI-compatible endpoint reports it — with no
# "-cloud" suffix, which is Ollama's native/CLI naming and is rejected here.
# Models get retired, and a retired name fails every request rather than
# falling back. If Study Buddy reports the model is no longer offered, list
# what your key can actually reach and set one of those:
#   curl -H "Authorization: Bearer $OLLAMA_API_KEY" https://ollama.com/v1/models
AI_MODEL="gpt-oss:120b"

# — OpenAI, if AI_PROVIDER=openai —
AI_API_KEY=""
# AI_MODEL="gpt-4o-mini"

# ─── Email ───────────────────────────────────────────────────────────────────
# Resend is an HTTP API, not SMTP, so there is no host/port/username to set —
# which is also why it works from a serverless function without a socket.
# EMAIL_FROM must be on a domain verified in Resend or every send is rejected.
EMAIL_PROVIDER="resend"
EMAIL_FROM="noreply@yourverifieddomain.com"
EMAIL_API_KEY=""

# ─── Optional ────────────────────────────────────────────────────────────────
REDIS_URL=""

# ─── Feature flags ───────────────────────────────────────────────────────────
ENABLE_AI="true"

# Log verbosity: debug | info | warn | error.
# Unset is fine - debug in development, info otherwise.
# LOG_LEVEL=""
